# development | production
ENVIRONMENT=development

# Comma-separated browser origins if the frontend is hosted separately.
FRONTEND_URL=
ALLOWED_ORIGINS=

# Gemini powers per-chunk embeddings and grounded answer generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_RPM=60
GEMINI_GENERATION_RPM=10
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_RETRY_MAX_SECONDS=30

# Qdrant Cloud is persistent; leave the URL blank for local embedded Qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# Supabase Auth, Postgres (RLS), and private Storage.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Older frontend environment names are accepted as aliases:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
